{
	"compilerOptions": {
		"declaration": true,
		"esModuleInterop": true,
		"lib": ["es2020"],
		"module": "commonjs",
		"newLine": "LF",
		"noEmitOnError": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"strict": true,
		"stripInternal": true,
		"types": ["node"],
		"target": "es2020"
	}
}
