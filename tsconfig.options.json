{
	"compilerOptions": {
		"declaration": true,
		"erasableSyntaxOnly": true,
		"lib": ["es2022"],
		"module": "nodenext",
		"newLine": "LF",
		"noEmitOnError": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"rewriteRelativeImportExtensions": true,
		"strict": true,
		"stripInternal": true,
		"types": ["node"],
		"target": "es2022",
		"verbatimModuleSyntax": true
	}
}
