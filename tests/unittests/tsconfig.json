{
	"extends": "../../tsconfig.options.json",
	"compilerOptions": {
		// tests are executed from sources directly so there is no need to emit anything
		"allowImportingTsExtensions": true,
		"composite": true,
		"noEmit": true,
		"rewriteRelativeImportExtensions": false,
		"incremental": true,
		"types": ["node", "mocha"]
	},
	"references": [
		{ "path": "../../src" },
	],
	"include": [
		"**/*.spec.ts"
	]
}
